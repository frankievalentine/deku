---
import ChatPane from '@pelagornis/page/components/ChatPane.astro';

const chatProvider = (import.meta.env.PUBLIC_DOC_CHAT_PROVIDER ?? 'openai') as
  | 'openai'
  | 'claude'
  | 'gemini';
const chatModel = import.meta.env.PUBLIC_DOC_CHAT_MODEL;
const showChat = process.env.PAGE_DOC_CHAT_ENABLED === '1';
const chatBase = (process.env.PAGE_BASE ?? '').replace(/\/$/, '') || '';
const locale = (Astro.locals.starlightRoute as { locale?: string } | undefined)?.locale ?? 'en';
const route = Astro.locals.starlightRoute as
  | { entry?: { data?: { hero?: unknown } } }
  | undefined;
// Splash pages render the hero instead of Starlight's `<h1 id="_top">`, which leaves the
// skip link without a target. Give the content wrapper that id on those pages only.
const skipLinkTarget = route?.entry?.data?.hero ? '_top' : undefined;
---

{
  showChat ? (
    <div class="page page-has-chat sl-flex">
      <div class="page-nav-wrap">
        <header class="header">
          <slot name="header" />
        </header>
        <div class="page-scroll-wrap">
          <div class="main-frame" id={skipLinkTarget}>
            <slot />
          </div>
        </div>
      </div>
      <ChatPane
        basePath={chatBase}
        provider={chatProvider}
        model={chatModel}
        locale={locale}
      />
    </div>
  ) : (
    <div class="page sl-flex">
      <header class="header">
        <slot name="header" />
      </header>
      <div class="page-scroll-wrap">
        <div class="main-frame" id={skipLinkTarget}>
          <slot />
        </div>
      </div>
    </div>
  )
}

<script>
  function initMobileMenuAccessibility() {
    const toggle = document.getElementById("page-mobile-menu-toggle") as HTMLButtonElement | null;
    const overlay = document.getElementById("page-mobile-menu-overlay");
    const closeButton = overlay?.querySelector<HTMLButtonElement>(".page-mobile-menu-close");

    if (!toggle || !overlay || !closeButton || toggle.dataset.a11yBound === "true") return;

    toggle.dataset.a11yBound = "true";
    toggle.setAttribute("aria-haspopup", "dialog");
    toggle.setAttribute("aria-controls", "page-mobile-menu-overlay");
    toggle.setAttribute("aria-expanded", "false");
    overlay.setAttribute("role", "dialog");
    overlay.setAttribute("aria-modal", "true");
    overlay.setAttribute("aria-label", "Documentation navigation");

    const isOpen = () => overlay.classList.contains("page-mobile-menu-open");

    const focusable = () =>
      Array.from(
        overlay.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
        ),
      ).filter((element) => element.offsetParent !== null);

    const onKeydown = (event: KeyboardEvent) => {
      if (!isOpen()) return;

      if (event.key === "Escape") {
        event.preventDefault();
        closeButton.click();
        return;
      }

      if (event.key !== "Tab") return;

      const elements = focusable();
      if (elements.length === 0) return;

      const first = elements[0];
      const last = elements[elements.length - 1];
      const active = document.activeElement;

      if (event.shiftKey && (active === first || !overlay.contains(active))) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && active === last) {
        event.preventDefault();
        first.focus();
      }
    };

    document.addEventListener("keydown", onKeydown);
    window.addEventListener("pagehide", () => document.removeEventListener("keydown", onKeydown), {
      once: true,
    });

    let wasOpen = false;

    new MutationObserver(() => {
      const open = isOpen();
      toggle.setAttribute("aria-expanded", String(open));

      if (open) {
        closeButton.focus();
      } else if (wasOpen) {
        const active = document.activeElement;
        // Hiding the focused element can already have moved focus to <body>, so accept that too.
        if (active === null || active === document.body || overlay.contains(active)) {
          toggle.focus();
        }
      }

      wasOpen = open;
    }).observe(overlay, { attributes: true, attributeFilter: ["class", "style"] });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initMobileMenuAccessibility);
  } else {
    initMobileMenuAccessibility();
  }
</script>

<style>
  .page {
    height: 100vh;
    width: 100%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .page-has-chat {
    flex-direction: row;
    flex-wrap: nowrap;
    overflow-x: hidden;
  }

  .page-nav-wrap {
    flex: 1 1 auto;
    min-width: 0;
    min-height: 0;
    width: 100%;
    max-width: 100%;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    overflow: hidden;
  }

  :global(body.page-chat-open) .page-nav-wrap {
    overflow-x: auto;
    min-width: 0;
  }

  @media (min-width: 1025px) {
    :global(body.page-chat-open) .page-nav-wrap {
      width: calc(100% - var(--page-chat-pane-width, 360px)) !important;
      max-width: calc(100% - var(--page-chat-pane-width, 360px)) !important;
      flex: 0 0 auto;
    }
  }

  .page-scroll-wrap {
    flex: 1 1 auto;
    min-height: 0;
    min-width: 0;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
  }

  .main-frame {
    width: 100% !important;
    margin-left: 0 !important;
    padding-left: 0 !important;
    flex: 1 1 auto;
    min-width: 0;
  }

  @media (max-width: 1024px) {
    :global(body.page-chat-open) .page-nav-wrap {
      padding-bottom: 70vh;
    }
  }

  .header {
    position: relative;
    top: 0;
    left: 0;
    z-index: 100;
    flex-shrink: 0;
    width: 100%;
    max-width: 100%;
    min-width: 0;
  }

  @media (min-width: 1025px) {
    :global(body.page-chat-open) .header {
      width: calc(100vw - var(--page-chat-pane-width, 360px));
      max-width: calc(100vw - var(--page-chat-pane-width, 360px));
    }
  }
</style>
