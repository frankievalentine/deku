---
import { NAV_ITEMS } from '../lib/shell';
import Icon from './Icon';

export interface Props {
  activeNav?: string;
}

const { activeNav } = Astro.props;

const NAV_GROUPS = [
  {
    id: 'operate',
    label: 'Apps',
    items: NAV_ITEMS.filter((item) => ['apps', 'services', 'storage', 'routing'].includes(item.id)),
  },
  {
    id: 'host',
    label: 'Server',
    items: NAV_ITEMS.filter((item) => ['host', 'access'].includes(item.id)),
  },
  {
    id: 'dashboard',
    label: 'Dashboard',
    items: NAV_ITEMS.filter((item) => ['settings', 'api'].includes(item.id)),
  },
];
---

<aside
  id="dashboard-sidebar"
  class="sidebar shell-sidebar"
  data-side="left"
  data-breakpoint="1024"
  data-initial-open="true"
  data-initial-mobile-open="false"
  aria-hidden="false"
>
  <nav class="shell-sidebar-panel" aria-label="Main navigation">
    <div class="sidebar-brand">
      <div class="sidebar-brand-row">
        <a href="/" class="brand-link" aria-label="Deku home">
          <span class="brand-kicker">Dashboard</span>
          <span class="brand-wordmark">DEKU</span>
        </a>

        <button type="button" class="btn-sm-icon-outline sidebar-close-button" aria-label="Close navigation">
          <Icon name="close" size={16} />
        </button>
      </div>
    </div>

    <div class="sidebar-nav">
      {NAV_GROUPS.map((group) => (
        <div
          class="sidebar-group"
          role="group"
          aria-labelledby={`sidebar-group-${group.id}`}
        >
          <h3 class="sidebar-group-title" id={`sidebar-group-${group.id}`}>
            {group.label}
          </h3>
          <ul class="sidebar-group-list" role="list">
            {group.items.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={['nav-link', { active: activeNav === item.id }]}
                  aria-current={activeNav === item.id ? 'page' : undefined}
                  target={item.external ? '_blank' : undefined}
                  rel={item.external ? 'noopener noreferrer' : undefined}
                >
                  <Icon name={item.icon} size={18} className="nav-icon" />

                  <span class="nav-text">
                    <span>{item.label}</span>
                    <small>{item.description}</small>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="sidebar-locked-note">
      <p class="eyebrow">Connect</p>
      <p>Enter a dashboard token in the main panel to unlock navigation.</p>
    </div>

    <div class="sidebar-footer">
      <div id="shell-sidebar-footer-controls"></div>
    </div>
  </nav>
</aside>
