---
export interface Props {
  activeNav?: string;
}

const { activeNav } = Astro.props;

const navItems = [
  { href: '/', label: 'Apps', id: 'apps', icon: 'grid' },
  { href: '/host', label: 'Host', id: 'host', icon: 'server' },
  { href: '/routing', label: 'Routing', id: 'routing', icon: 'route' },
  { href: '/services', label: 'Services', id: 'services', icon: 'database' },
  { href: '/object-store', label: 'Object Store', id: 'object-store', icon: 'cloud' },
  { href: '/ssh-keys', label: 'SSH Keys', id: 'ssh-keys', icon: 'key' },
  { href: '/plugins', label: 'Plugins', id: 'plugins', icon: 'plug' },
];
---

<nav class="sidebar" aria-label="Main navigation">
  <div class="sidebar-brand">
    <a href="/" class="brand-link" aria-label="Deku home">
      <span class="brand-kicker">Control surface</span>
      <span class="brand-wordmark">DEKU</span>
    </a>
  </div>

  <ul class="sidebar-nav" role="list">
    {navItems.map((item) => (
      <li>
        <a
          href={item.href}
          class:list={['nav-link', { active: activeNav === item.id }]}
          aria-current={activeNav === item.id ? 'page' : undefined}
        >
          <svg class="nav-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            {item.icon === 'grid' && (
              <>
                <rect x="1" y="1" width="6" height="6" rx="1" fill="currentColor" />
                <rect x="9" y="1" width="6" height="6" rx="1" fill="currentColor" />
                <rect x="1" y="9" width="6" height="6" rx="1" fill="currentColor" />
                <rect x="9" y="9" width="6" height="6" rx="1" fill="currentColor" />
              </>
            )}
            {item.icon === 'server' && (
              <path d="M2 2.5A1.5 1.5 0 0 1 3.5 1h9A1.5 1.5 0 0 1 14 2.5v2A1.5 1.5 0 0 1 12.5 6h-9A1.5 1.5 0 0 1 2 4.5zm0 5A1.5 1.5 0 0 1 3.5 6h9A1.5 1.5 0 0 1 14 7.5v2A1.5 1.5 0 0 1 12.5 11h-9A1.5 1.5 0 0 1 2 9.5zm1.5-5a.5.5 0 0 0 0 1h1a.5.5 0 0 0 0-1zm0 5a.5.5 0 0 0 0 1h1a.5.5 0 0 0 0-1zM2 12.5A1.5 1.5 0 0 1 3.5 11h9a1.5 1.5 0 0 1 1.5 1.5v1A1.5 1.5 0 0 1 12.5 15h-9A1.5 1.5 0 0 1 2 13.5zm1.5-.5a.5.5 0 0 0 0 1h1a.5.5 0 0 0 0-1z" fill="currentColor" />
            )}
            {item.icon === 'key' && (
              <path d="M10.5 1a4.5 4.5 0 1 0 0 9 4.5 4.5 0 0 0 0-9zM7 5.5a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0zm-1.854 3.646L1 13.293V15h1.707l.5-.5V13.5H4.5V12h1.207l1.046-1.046A5.505 5.505 0 0 1 5.146 9.146z" fill="currentColor" />
            )}
            {item.icon === 'database' && (
              <path d="M8 1C4.686 1 2 2.12 2 3.5v9C2 13.88 4.686 15 8 15s6-1.12 6-2.5v-9C14 2.12 11.314 1 8 1zm0 1c2.995 0 5 .966 5 1.5S10.995 5 8 5 3 4.034 3 3.5 5.005 2 8 2zm0 5c2.02 0 3.846-.398 5-1.048V8.5C13 9.034 10.995 10 8 10S3 9.034 3 8.5V5.952C4.154 6.602 5.98 7 8 7zm0 7c-2.995 0-5-.966-5-1.5V10.952C4.154 11.602 5.98 12 8 12s3.846-.398 5-1.048V12.5c0 .534-2.005 1.5-5 1.5z" fill="currentColor" />
            )}
            {item.icon === 'route' && (
              <path d="M3 2.5a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3zm10 8a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3zM3 9a2 2 0 0 0 2 2h4a1 1 0 0 1 1 1V13h1v-1a2 2 0 0 0-2-2H5a1 1 0 0 1-1-1V5.415A2.5 2.5 0 0 0 5.5 3h5v1h1V2h-1v1h-5A2.498 2.498 0 0 0 3 1.5 2.5 2.5 0 0 0 3 6.5c0 .19.021.374.06.55A2 2 0 0 0 3 9zm10 6.5A2.5 2.5 0 0 0 15.5 13 2.5 2.5 0 0 0 13 10.5 2.5 2.5 0 0 0 10.55 13H7v1h3.55A2.5 2.5 0 0 0 13 15.5z" fill="currentColor" />
            )}
            {item.icon === 'plug' && (
              <path d="M6 1v3H4v2h2v1.268A4 4 0 0 0 8 15a4 4 0 0 0 2-7.732V6h2V4h-2V1H6zm2 6.268A2 2 0 1 1 8 11V7.268z" fill="currentColor" />
            )}
            {item.icon === 'cloud' && (
              <path d="M5.5 13.5h6a3 3 0 1 0-.447-5.967A4.501 4.501 0 0 0 2.5 8.5a2.5 2.5 0 0 0 3 5zm.5-1h5.5a2 2 0 1 0-.234-3.986l-.745.087-.124-.741a3.5 3.5 0 0 0-6.897.64v.5l-.447.224A1.5 1.5 0 0 0 4 12.5z" fill="currentColor" />
            )}
          </svg>
          <span>{item.label}</span>
        </a>
      </li>
    ))}
  </ul>

</nav>

<style>
  .sidebar {
    position: fixed;
    top: 0;
    left: 0;
    width: var(--sidebar-width);
    height: 100vh;
    background:
      linear-gradient(180deg, rgba(242, 178, 82, 0.12), transparent 24%),
      linear-gradient(180deg, rgba(15, 18, 20, 0.98), rgba(15, 18, 20, 0.88));
    border-right: 1px solid var(--color-border-strong);
    display: flex;
    flex-direction: column;
    z-index: 100;
    overflow-y: auto;
    backdrop-filter: blur(18px);
  }

  .sidebar-brand {
    padding: var(--space-6) var(--space-5) var(--space-5);
    border-bottom: 1px solid rgba(242, 178, 82, 0.18);
    flex-shrink: 0;
  }

  .brand-link {
    text-decoration: none;
    color: var(--color-text-primary);
    display: grid;
    gap: 0.35rem;
  }

  .brand-kicker {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-text-muted);
  }

  .brand-wordmark {
    font-family: var(--font-heading);
    font-size: 1.65rem;
    font-weight: 800;
    color: var(--color-accent);
    letter-spacing: 0.08em;
  }

  .sidebar-nav {
    flex: 1;
    padding: var(--space-5) var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: 0.9rem 0.95rem;
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition: var(--transition-fast);
    border: 1px solid transparent;
  }

  .nav-link:hover {
    background: rgba(255, 255, 255, 0.03);
    color: var(--color-text-primary);
    border-color: rgba(242, 178, 82, 0.12);
  }

  .nav-link.active {
    background:
      linear-gradient(135deg, rgba(242, 178, 82, 0.22), rgba(242, 178, 82, 0.08)),
      rgba(255, 255, 255, 0.03);
    color: var(--color-accent);
    border-color: rgba(242, 178, 82, 0.28);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.04);
  }

  .nav-icon {
    flex-shrink: 0;
    opacity: 0.9;
  }

  @media (max-width: 960px) {
    .sidebar {
      position: sticky;
      width: 100%;
      height: auto;
      border-right: 0;
      border-bottom: 1px solid var(--color-border-strong);
    }

    .sidebar-nav {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    }

  }

  @media (max-width: 640px) {
    .sidebar-nav {
      grid-template-columns: 1fr;
    }
  }
</style>
