[Unit]
Description=Deku PaaS Daemon
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
# Stop retrying after ten failed starts in five minutes, so a broken config or
# binary shows up as a failed unit instead of a silent restart loop.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStart=__DEKU_INSTALL_DIR__/dekud
Restart=always
RestartSec=5
User=root
Environment=HOME=/root
Environment=RUST_LOG=info
UMask=0077
LimitNOFILE=65536

# dekud runs as root and drives the Docker socket, so it is root-equivalent
# whatever this unit says. These settings remove what it never needs.
#
# The filesystem is deliberately left writable: it writes Angie's config,
# certificates and logs under /etc/angie, /var/lib/angie and /var/log/angie,
# state under /var/lib/deku or ~/.deku, and build trees under /tmp. PrivateTmp is
# off because restore helpers bind-mount temp files into containers, and Docker
# resolves those paths in the host's /tmp, not this unit's.
NoNewPrivileges=yes
ProtectSystem=true
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
